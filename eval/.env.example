# Copy this file to eval/.env (which is gitignored) and fill in real values.
# These live ONLY in the environment / .env — never in tracked source.

# The Anthropic model id to judge with (the product's verdict model).
VP_MODEL=<your-anthropic-model-id>

# Your Anthropic API key.
ANTHROPIC_API_KEY=<your-key>

# Optional: max output tokens per verdict (default 1024).
# VP_MAX_TOKENS=1024
