# venture-pilot — copy this file to `.env` and fill it in to run on YOUR OWN API key.
#
#   cp .env.example .env      # then edit the two values below
#
# An Anthropic API key (console.anthropic.com) is pay-per-token and SEPARATE from a
# Claude.ai Pro/Max subscription. If you'd rather use a Claude subscription instead of a
# key, skip this file and run with `--sdk` (see `vp doctor`).

# The model the verdict + synthesis run on (sonnet = great balance; opus = highest quality).
VP_MODEL=claude-sonnet-4-6

# Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — a cheaper model for the read-only research subagents.
# VP_FAST_MODEL=claude-sonnet-4-6
